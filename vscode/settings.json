{
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[go]": {
		"editor.codeActionsOnSave": {
			"source.organizeImports": "explicit"
		},
		"editor.defaultFormatter": "golang.go"
	},
	"[hcl]": {
		"editor.defaultFormatter": "fredwangwang.vscode-hcl-format"
	},
	"[html]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[ignore]": {
		"editor.formatOnSave": false
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[markdown]": {
		"editor.defaultFormatter": "rvben.rumdl",
		"files.trimTrailingWhitespace": false
	},
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff"
	},
	"[ruby]": {
		"editor.defaultFormatter": "Shopify.ruby-lsp"
	},
	"[shellscript]": {
		"editor.defaultFormatter": "mkhl.shfmt"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[yaml]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.biome": "explicit",
		"source.fixAll.ruff": "explicit",
		"source.fixAll.rumdl": "explicit",
		"source.fixAll.shellcheck": "explicit",
		"source.organizeImports.biome": "explicit",
		"source.organizeImports.ruff": "explicit"
	},
	"editor.fontFamily": "'MesloLGS Nerd Font', Menlo, Monaco, 'Courier New', monospace",
	"editor.formatOnSave": true,
	"editor.minimap.enabled": false,
	"editor.showFoldingControls": "always",
	"editor.tabSize": 2,
	"editor.wordWrap": "on",
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"files.eol": "\n",
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.trimTrailingWhitespace": true,
	"git.openRepositoryInParentFolders": "never",
	"go.useLanguageServer": true,
	"gopls": {
		"formatting.gofumpt": true
	},
	"json.schemaDownload.trustedDomains": {
		"https://biomejs.dev": true,
		"https://developer.microsoft.com/json-schemas/": true,
		"https://json-schema.org/": true,
		"https://json.schemastore.org/": true,
		"https://raw.githubusercontent.com/devcontainers/spec/": true,
		"https://raw.githubusercontent.com/microsoft/vscode/": true,
		"https://schemastore.azurewebsites.net/": true,
		"https://www.schemastore.org/": true
	},
	"makefile.configureOnOpen": false,
	"markdown.extension.preview.autoShowPreviewToSide": true,
	"markdown.extension.toc.levels": "2..6",
	"markdown.preview.doubleClickToSwitchToEditor": true,
	"markdown.preview.markEditorSelection": true,
	"mise.checkForNewMiseVersion": false,
	"python.terminal.activateEnvironment": false,
	"search.followSymlinks": false,
	"search.showLineNumbers": true,
	"terminal.integrated.initialHint": false,
	"terminal.integrated.scrollback": 10000,
	"terminal.integrated.shellIntegration.decorationsEnabled": "never",
	"terminal.integrated.stickyScroll.enabled": false,
	"terminal.integrated.suggest.enabled": false,
	"window.newWindowDimensions": "inherit",
	"workbench.activityBar.location": "top",
	"workbench.colorTheme": "Catppuccin Mocha",
	"workbench.editor.enablePreview": false,
	"workbench.editorAssociations": {
		"*.md": "vscode.markdown.editor"
	},
	"workbench.iconTheme": "catppuccin-mocha",
	"workbench.startupEditor": "none"
}
