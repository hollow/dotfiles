# typography
font-family = MesloLGS Nerd Font
font-size = 12

# theme
theme = Catppuccin Mocha
unfocused-split-opacity = 0.6
unfocused-split-fill = #000000

# ssh: set TERM=xterm-256color for ssh sessions. Without this, remote hosts see
# TERM=xterm-ghostty (no such terminfo entry) and every `tput` fails. We don't
# use ssh-terminfo (install the real ghostty terminfo remotely) because it fails
# and adds latency on our fleet. It also breaks `ssu`: its installer appends a
# command to our ssh args, which OpenSSH rejects alongside RemoteCommand, and
# root via `sudo -i` would never see the user's ~/.terminfo entry anyway.
shell-integration-features = ssh-env

# macOS
macos-non-native-fullscreen = visible-menu

# macOS line + word navigation
# Ghostty's defaults are shell-friendly for these chords, but not Vim-friendly:
#   Cmd+Left/Right     defaults to Ctrl-A/Ctrl-E
#   Option+Left/Right  defaults to Esc-b/Esc-f
# Send standard terminal navigation sequences instead so ZLE, Vim, and Neovim
# can all keep their own defaults/mappings:
#   Cmd+Left/Right     -> Home/End
#   Option+Left/Right  -> Shift+Left/Shift+Right
keybind = super+arrow_left=csi:H
keybind = super+arrow_right=csi:F
keybind = alt+arrow_left=csi:1;2D
keybind = alt+arrow_right=csi:1;2C

# scrollback
scrollback-limit = 134217728

# always start in home directory
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false

# macOS prompt editing
keybind = alt+backspace=text:\x1b\x7f
keybind = shift+enter=text:\n
