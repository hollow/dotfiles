#!/bin/sh
# Terraform credentials helper: serves the HCP Terraform token from 1Password.
# Protocol: https://developer.hashicorp.com/terraform/internals/credentials-helpers
# Read-only: `store` and `forget` fail, so `terraform login` cannot write a token to disk.
set -eu

case "${1:-}" in
  get)
    if [ "${2:-}" != "app.terraform.io" ]; then
      echo '{}'
      exit 0
    fi
    # The helper shell may carry a service-account token that scopes op to another vault.
    unset OP_SERVICE_ACCOUNT_TOKEN
    token=$(/opt/homebrew/bin/op item get d3kmh3wm7ee2efxghhdph5gsam \
      --account=remerge --fields 'label=API Token' --reveal)
    printf '{"token":"%s"}\n' "$token"
    ;;
  store | forget)
    echo "terraform-credentials-op is read-only; rotate the token in 1Password" >&2
    exit 1
    ;;
  *)
    echo "usage: terraform-credentials-op get|store|forget HOSTNAME" >&2
    exit 1
    ;;
esac
