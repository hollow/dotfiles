#!/usr/bin/env zsh
emulate -L zsh
[[ $TRACE -eq 1 ]] && set -x

# local branches only: never delete merged branches on any remote
git config get --all --show-names --regexp '^remote\..*\.dmb-enabled$' 2>/dev/null |
    while read -r key _; do git config unset "$key"; done
git config set branch."$(git main-branch)".dmb-required true
git config set delete-merged-branches.configured 5.0.0+
